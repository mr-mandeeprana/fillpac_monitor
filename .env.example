# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to source control.

# ---- Camera ----
CAMERA_USER=beumer
CAMERA_PASS=Beumer!123
# Optional: fully overrides config.yaml camera.source if set
# CAMERA_URL=rtsp://beumer:Beumer!123@172.20.45.131:554/video/live?channel=1&subtype=1

# ---- SQL Server (used with SSMS) ----
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=FillPacMonitor
DB_USER=fillpac_svc
DB_PASSWORD=change_me
# If using Windows Authentication instead of SQL auth, set DB_TRUSTED_CONNECTION=true
# and DB_USER/DB_PASSWORD are ignored.
DB_TRUSTED_CONNECTION=false

# ---- Runtime ----
ENV=production
